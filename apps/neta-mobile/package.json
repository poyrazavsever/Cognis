{
  "name": "@neta/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@neta/api-contracts": "workspace:*",
    "@neta/design-tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "pnpm ios:pods && expo run:ios",
    "ios:pods": "sh ./scripts/ios-pods.sh",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts",
    "config:check": "expo config --type public",
    "instance:smoke": "node --env-file-if-exists=.env scripts/instance-smoke.mjs",
    "doctor": "npx expo-doctor@latest",
    "i18n:check": "node scripts/i18n-raw-key-scan.mjs",
    "a11y:check": "node scripts/accessibility-release-gate.mjs",
    "redesign:phase0": "node scripts/redesign-phase0-gate.mjs",
    "redesign:phase6-7": "node scripts/redesign-phase6-7-gate.mjs",
    "redesign:phase8-11": "node scripts/redesign-phase8-11-gate.mjs",
    "redesign:phase12": "node scripts/redesign-phase12-gate.mjs && node scripts/native-release-gate.mjs && node scripts/fork-config-smoke.mjs",
    "native:verify": "node scripts/native-release-gate.mjs",
    "fork:config-smoke": "node scripts/fork-config-smoke.mjs",
    "native:build:android": "cd android && ./gradlew app:assembleRelease",
    "native:build:ios": "xcodebuild -workspace ios/Neta.xcworkspace -scheme Neta -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "release:guard": "node scripts/production-release-gate.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm i18n:check && pnpm a11y:check && pnpm redesign:phase0 && pnpm redesign:phase6-7 && pnpm redesign:phase8-11 && pnpm redesign:phase12 && pnpm config:check",
    "release:check": "pnpm check && pnpm release:guard"
  },
  "private": true
}
